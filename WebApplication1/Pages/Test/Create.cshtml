@model WebApplication1.Pages.Test.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TestClass</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TestClass.DeviceId" class="control-label"></label>
                <select asp-for="TestClass.DeviceId" id="deviceIdDropdown" class ="form-control" asp-items="ViewBag.Device"></select>
            </div>
            @* <div class="form-group">
                <label asp-for="TestClass.TestId" class="control-label"></label>
                <input asp-for="TestClass.TestId" class="form-control" />
                <span asp-validation-for="TestClass.TestId" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="TestClass.Name" class="control-label"></label>
                <input asp-for="TestClass.Name" class="form-control" />
                <span asp-validation-for="TestClass.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TestClass.DataValue" class="control-label"></label>
                <div class="input-group">
                    <input asp-for="TestClass.DataValue" class="form-control" />
                    <select asp-for="TestClass.Unit" class="form-control">
                        <option value="V">V</option>
                        <option value="A">A</option>
                    </select>
                </div>
                <span asp-validation-for="TestClass.DataValue" class="text-danger"></span>
                <span asp-validation-for="TestClass.Unit" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="TestClass.Percentage" class="control-label"></label>
                <input asp-for="TestClass.Percentage" class="form-control" />
                <span asp-validation-for="TestClass.Percentage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TestClass.DataLow" class="control-label"></label>
                <input asp-for="TestClass.DataLow" class="form-control" />
                <span asp-validation-for="TestClass.DataLow" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TestClass.DataHigh" class="control-label"></label>
                <input asp-for="TestClass.DataHigh" class="form-control" />
                <span asp-validation-for="TestClass.DataHigh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TestClass.DataTest" class="control-label"></label>
                <input asp-for="TestClass.DataTest" class="form-control" />
                <span asp-validation-for="TestClass.DataTest" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
